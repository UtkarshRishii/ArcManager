<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for splash screen -->
    <style name="Theme.ArcManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF0A0A0F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ArcManager.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0A0A0F</item>
        <item name="postSplashScreenTheme">@style/Theme.ArcManager</item>
    </style>
</resources>
